APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
DB_URL=postgres://ruangku:ruangku@localhost:5432/ruangku?sslmode=disable
JWT_SECRET=change-me-to-at-least-32-characters!!
JWT_TTL_MINUTES=15
JWT_REFRESH_SECRET=change-me-too-must-differ-from-jwt-secret
JWT_REFRESH_TTL_HOURS=168
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@ruangku.local
ADMIN_PASSWORD=admin12345

REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ruangku
WORKER_CONCURRENCY=5

