APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
DB_URL=postgres://<pg_username>:<pg_password>@<pg_host>:<pg_port>/ruangku?sslmode=disable
JWT_SECRET=change-me-to-at-least-32-characters!!
JWT_TTL_MINUTES=15
JWT_REFRESH_SECRET=change-me-too-must-differ-from-jwt-secret
JWT_REFRESH_TTL_HOURS=168
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=example_password_123

REDIS_ADDR=<redis_host>:<redis_port>
REDIS_DB=0
MONGO_URI=mongodb://<mongo_host>:<mongo_port>
MONGO_DB=mongo_db_name
WORKER_CONCURRENCY=5

# Optional host ports for docker compose (defaults shown).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MONGO_PORT=27017
