APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
DB_URL=postgres://<pg_username>:<pg_password>@<pg_host>:<pg_port>/<pg_db_name>?sslmode=disable
JWT_SECRET=
JWT_TTL_MINUTES=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_HOURS=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

REDIS_ADDR=<redis_host>:<redis_port>
REDIS_DB=0
MONGO_URI=mongodb://<mongo_host>:<mongo_port>
MONGO_DB=mongo_db_name
WORKER_CONCURRENCY=5

# Optional host ports for docker compose (defaults shown).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MONGO_PORT=27017
