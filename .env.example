APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
DB_URL=postgres://<pg_username>:<pg_password>@<pg_host>:<pg_port>/<pg_db_name>?sslmode=disable
# Secrets: min 32 chars; JWT_REFRESH_SECRET must differ from JWT_SECRET.
JWT_SECRET=
JWT_TTL_MINUTES=15
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_HOURS=168
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ruangku
WORKER_CONCURRENCY=5

# Optional host ports for docker compose (defaults shown).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MONGO_PORT=27017
